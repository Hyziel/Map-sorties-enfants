---
import '@fontsource-variable/nunito';
import '../styles/global.css';
import '../styles/composants.css';
import { EDITEUR, ANNEE, SITE } from '../consts';
import Entete from '../components/Entete.astro';

interface Props {
  titre: string;
  description: string;
  /** Données structurées schema.org à injecter dans le <head>. */
  schema?: unknown;
  /** Compteurs affichés dans l'entête, sur la carte seulement. */
  sorties?: number;
  services?: number;
  /** Entête resserré, quand la page doit tenir dans la fenêtre. */
  enteteCompacte?: boolean;
}

const { titre, description, schema, sorties, services, enteteCompacte } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const schemaSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Sorties enfants Genève',
  url: SITE,
  inLanguage: 'fr-CH',
  description,
  publisher: { '@type': 'Person', name: EDITEUR },
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fbeaf0" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_CH" />

    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎠</text></svg>"
    />
    <script is:inline>
      // Appliqué avant le rendu pour éviter un éclair de thème clair au chargement.
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {
        /* localStorage indisponible (navigation privée) : on suit le système. */
      }
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema ? [schemaSite, schema] : schemaSite)}
    />
  </head>
  <body>
    <Entete sorties={sorties} services={services} compact={enteteCompacte} />

    <slot />

    <footer class="pied-site">
      <p>
        © {ANNEE} {EDITEUR}, tous droits réservés.
        <a href="/mentions-legales/">Mentions légales et contact</a>
      </p>
    </footer>

    <script>
      import '../scripts/theme';
    </script>
  </body>
</html>
