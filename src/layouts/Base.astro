---
import '@fontsource-variable/nunito';
import '../styles/global.css';
import '../styles/composants.css';

interface Props {
  titre: string;
  description: string;
}

const { titre, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f6a9a0" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_CH" />

    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎠</text></svg>"
    />
    <script is:inline>
      // Appliqué avant le rendu pour éviter un éclair de thème clair au chargement.
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {
        /* localStorage indisponible (navigation privée) : on suit le système. */
      }
    </script>
  </head>
  <body>
    <slot />

    <button type="button" id="bascule-theme" class="bascule-theme" aria-pressed="false">
      <span class="icone" aria-hidden="true"></span>
      <span class="sr-only">Basculer entre le thème clair et sombre</span>
    </button>

    <script>
      import '../scripts/theme';
    </script>
  </body>
</html>
